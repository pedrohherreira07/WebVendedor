@{
    Layout = "_Layout";
}
<div id="divPai">
    <div class="form-group col-md-6">
        <label>Nome</label>
        <input class="form-control" placeholder="Altere seu nome..." id="nome" obg/>
    </div>
    <div class="form-group col-md-6">
        <label>E-mail</label>
        <input class="form-control" placeholder="Altere seu e-mail..." id="email" obg/>
    </div>
    <div class="form-group col-md-6">
        <label>Telefone</label>
        <input class="form-control" placeholder="Altere seu telefone..." id="telefone" obg/>
    </div>
    <div class="form-group col-md-6">
        <label>Endereço</label>
        <input class="form-control" placeholder="Altere seu endereço..." id="endereco" obg/>
    </div>
    <div class="col-md-12">
        <button class="btn btn-success" id="btnSalvar">Salvar</button>
    </div>
</div>
<script src="~/js-sistema/vendedor.js"></script>
<script>
    getElemento("btnSalvar").addEventListener("click", salvar)
</script>