@{
    Layout = "_layout";
}
<div id="dadosFiltro">
    <div class="form-group col-md-4">
        <label>Data inicial</label>
        <input class="form-control" type="date" id="dataInicial" obg />
    </div>
    <div class="form-group col-md-4">
        <label>Data final</label>
        <input class="form-control" type="date" id="dataFinal" obg />
    </div>
    <div class="form-group col-md-4">
        <label>Forma de pagamento</label>
        <select class="form-control">
            <option value="">Selecione</option>
            <option value="1">Dinheiro</option>
            <option value="">Cheque</option>
            <option value="3">PIX</option>
            <option value="4">Cartão de crédito</option>
            <option value="5">Cartão de débito</option>
            <option value="6">Boleto</option>
            <option value="7">Financiamento</option>
        </select>
    </div>
</div>
<button class="btn btn-primary btn-lg center-block" id="btnPesquisar">Pesquisar</button>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- Advanced Tables -->
        <div class="panel panel-default">
            <div class="panel-heading">Vendas encontrada(s)</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Cor</th>
                                <th>R$ Venda</th>
                                <th>Cliente</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="odd gradeX">
                                <td>(marca)</td>
                                <td>(modelo)</td>
                                <td>(cor)</td>
                                <td>(R$ venda)</td>
                                <td>(cliente)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!--End Advanced Tables -->
    </div>
</div>
<script src="~/js-sistema/venda.js"></script>
<script>
    getElemento("btnPesquisar").addEventListener("click", filtrarMinhasVendas)
</script>