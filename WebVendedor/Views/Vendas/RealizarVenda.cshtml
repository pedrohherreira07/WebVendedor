@{
    Layout = "_layout";
}
<div class="form-group col-md-6">
    <label>Marca</label>
    <select class="form-control">
        <option value="">Selecione</option>
    </select>
</div>
<div class="form-group col-md-6">
    <label>Modelo</label>
    <select class="form-control">
        <option value="">Selecione</option>
    </select>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- Advanced Tables -->
        <div class="panel panel-default">
            <div class="panel-heading">Veiculos encontrado(s)</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Cor</th>
                                <th>R$ Venda</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="odd gradeX">
                                <td>
                                    <button class="btn btn-info btn-sm" data-toggle="modal" data-target="#modalDetalheVeiculo">Detalhes</button>
                                    <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#modalFinalizarVenda">Selecionar</button>
                                </td>
                                <td>(marca)</td>
                                <td>(modelo)</td>
                                <td>(cor)</td>
                                <td>(R$ venda)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!--End Advanced Tables -->
    </div>
</div>
@await Html.PartialAsync("../_Modal/_DetalhesVeiculo")
@await Html.PartialAsync("../_Modal/_FinalizarVenda")
<script src="~/js-sistema/venda.js"></script>
<script>
    getElemento("btnFinalizar").addEventListener("click", finalizar)
</script>