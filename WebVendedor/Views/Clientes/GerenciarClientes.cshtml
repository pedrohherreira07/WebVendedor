@{
    Layout = "_layout";
}
<button class="btn btn-primary btn-lg center-block" data-toggle="modal" data-target="#modalCliente">+ Novo cliente</button>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- Advanced Tables -->
        <div class="panel panel-default">
            <div class="panel-heading">Clientes encontrados</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome</th>
                                <th>Telefone</th>
                                <th>Endereço</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="odd gradeX">
                                <td>
                                    <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#modalCliente">Alterar</button>
                                    <button class="btn btn-danger btn-sm">Excluir</button>
                                </td>
                                <td>(cliente)</td>
                                <td>(telefone)</td>
                                <td>(endereço)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!--End Advanced Tables -->
    </div>
</div>
@await Html.PartialAsync("../_Modal/_Cliente")
<script>
    getElemento("btnSalvar").addEventListener("click", salvar)
</script>